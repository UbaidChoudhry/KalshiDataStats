# Public Kalshi market-data API. No API key is required for Phase 1.
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_REQUESTS_PER_SECOND=5
# Optional maximum on-disk data size in GiB. Leave blank for no limit.
KALSHI_MAX_STORAGE_GB=
KALSHI_429_PAUSE_SECONDS=60
KALSHI_429_MAX_PAUSES=3

# Must resolve outside this Git repository. Leave unset for the macOS default:
# ~/Library/Application Support/KalshiDataStats
# KALSHI_DATA_DIR=/absolute/path/outside/the/repository

# Use "demo" only for deterministic offline development and tests.
KALSHI_SYNC_MODE=real
